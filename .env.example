# ==============================================================================
# AI System Design — Reference Implementation Environment Configuration
# ==============================================================================
# Copy this file to .env before running the application:
#   cp .env.example .env
#
# Defaults work out of the box with Docker Compose (Postgres + Redis)
# and use the built-in mock LLM provider (no paid API keys required).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Default credentials match the docker-compose.yml configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aichat_db
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=aichat_db

# ------------------------------------------------------------------------------
# 3. Cache & State Store (Redis 7)
# ------------------------------------------------------------------------------
# Used for sliding-window rate limiting, idempotency locks, and session state
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: 'mock' (default, free, no API key needed) | 'openai-compatible' (OpenAI / vLLM / Ollama)
DEFAULT_PROVIDER=mock

# Optional: Required only if DEFAULT_PROVIDER is set to 'openai-compatible'
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 5. Rate Limiting & Resilience
# ------------------------------------------------------------------------------
RATE_LIMIT_REQUESTS_PER_MIN=60
RATE_LIMIT_TOKENS_PER_MIN=40000
RATE_LIMIT_MAX_CONCURRENT=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 6. Observability & Logging
# ------------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=4000
LOG_LEVEL=info
